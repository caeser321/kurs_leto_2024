{
  "id": "anketa",
  "title": "Анкета гостя",
  "organization": "Мнёшь Трёшь®",
  "version": "2.0",
  "sections": [
    {
      "title": "Гость",
      "fields": [
        {
          "name": "lastName",
          "label": "Фамилия",
          "type": "text",
          "required": true,
          "maxLength": 60,
          "autocomplete": "family-name"
        },
        {
          "name": "firstName",
          "label": "Имя",
          "type": "text",
          "required": true,
          "maxLength": 60,
          "autocomplete": "given-name"
        },
        {
          "name": "middleName",
          "label": "Отчество",
          "type": "text",
          "required": false,
          "maxLength": 60,
          "autocomplete": "additional-name"
        },
        {
          "name": "birthDate",
          "label": "Дата рождения",
          "type": "date",
          "required": true
        },
        {
          "name": "phone",
          "label": "Телефон",
          "type": "tel",
          "required": false,
          "maxLength": 30,
          "pattern": "^[0-9+()\\-\\s]{6,30}$",
          "placeholder": "+7 (___) ___-__-__",
          "hint": "Цифры, пробелы и символы + ( ) -",
          "autocomplete": "tel"
        }
      ]
    },
    {
      "title": "Противопоказания",
      "note": "Отметьте всё, что есть у вас. Если ничего не отмечено — считаем, что перечисленного у вас нет.",
      "fields": [
        {
          "name": "contraAbsolute",
          "label": "Оказывать услугу категорически нельзя",
          "type": "checklist",
          "note": "Коснитесь пункта, если он к вам относится",
          "options": [
            "Онкология",
            "Вирусные инфекции",
            "Температура тела выше 37 градусов",
            "Кровотечения и нарушения свертываемости крови (частые носовые, кишечные, маточные кровотечения, язва желудка со склонностью к кровотечению)",
            "Болезни крови (гемофилия, болезнь Виллебранда)",
            "Гнойники на теле",
            "Артериальная гипертония (160/100 и выше)",
            "Артериальная гипотония (80/60 и ниже)",
            "Острая аллергия",
            "Кишечные расстройства",
            "Почечная, печеночная, легочная, сердечная недостаточность",
            "Сифилис",
            "Аневризма",
            "Гангрена",
            "Активный туберкулез",
            "Трофические язвы",
            "Воспаленные лимфатические узлы",
            "Тромбозы и тромбофлебиты",
            "Алкогольное и/или наркотическое опьянение",
            "Периневральная киста более 1,5 см"
          ]
        },
        {
          "name": "contraLocal",
          "label": "Локальные противопоказания",
          "type": "checklist",
          "note": "Коснитесь пункта, если он к вам относится",
          "options": [
            "Варикоз от 2 степени",
            "Псориаз (в стадии ремиссии)",
            "Экзема",
            "Акне",
            "Грибок и другие заболевания кожи стопы",
            "Доброкачественные новообразования",
            "Повреждения кожного покрова",
            "Эндометриоз",
            "Грыжа межпозвоночного диска в период обострения"
          ]
        },
        {
          "name": "contraDoctor",
          "label": "Требуется консультация врача",
          "type": "checklist",
          "note": "Коснитесь пункта, если он к вам относится",
          "options": [
            "Наличие в теле металлоконструкций и инородных предметов (крепежи, штифты, искусственные суставы, грудные имплантаты, кардиостимуляторы)",
            "Мочекаменная болезнь",
            "Желчекаменная болезнь",
            "Склонность к повышенному и пониженному артериальному давлению",
            "Эпилепсия",
            "Сахарный диабет",
            "Хронические вывихи",
            "Установленная спираль/кольцо у женщин",
            "Гинекологические заболевания (полипы, кисты, миомы, эрозии)",
            "Послеоперационный период",
            "Глаукома",
            "Липома",
            "Постинсультный период",
            "Сердечные заболевания",
            "Атеросклероз, превышающий 20%",
            "Наличие травм",
            "Беременность",
            "Грыжи/протрузии",
            "Наличие любого другого хронического заболевания",
            "Удаление желчного пузыря"
          ]
        },
        {
          "name": "confirmContra",
          "label": "Подтверждаю, что проинформирован(а) о противопоказаниях к оказанию услуг, и обязуюсь сообщить об их наличии Исполнителю, непосредственно оказывающему услугу, до начала оказания услуг",
          "type": "checkbox",
          "required": true
        },
        {
          "name": "confirmRisk",
          "label": "Принимаю на себя ответственность за наступление любых неблагоприятных последствий неисполнения или несвоевременного исполнения обязанности по уведомлению о противопоказаниях, включая ухудшение состояния здоровья. Проинформирован(а) о возможном наступлении не ухудшающих состояния здоровья кратковременных побочных эффектов от оказания услуг: единичные покраснения; гематомы; болезненное ощущение в частях (областях) тела, которые были задействованы при проведении физкультурно-оздоровительных разминаний; чувство сонливости и усталости; ломота в теле; головная боль; петехиальные кровоизлияния",
          "type": "checkbox",
          "required": true
        },
        {
          "name": "consentPersonalData",
          "label": "Даю согласие ИП Озманяну А. Т. на обработку своих персональных данных (фамилия, имя, отчество, дата рождения, данные о состоянии своего здоровья, контактные данные и прочее)",
          "type": "checkbox",
          "required": true
        }
      ]
    },
    {
      "title": "Данные о состоянии здоровья",
      "fields": [
        {
          "name": "allergy",
          "label": "Бывают аллергические реакции?",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "allergyDetails",
          "label": "Укажите, на какие вещества или средства",
          "type": "textarea",
          "required": true,
          "maxLength": 500,
          "rows": 2,
          "showIf": {
            "field": "allergy",
            "equals": "Да"
          }
        },
        {
          "name": "skinFeatures",
          "label": "Есть индивидуальные особенности кожи (объёмные родинки, папилломы и пр.), на которые мы должны обратить внимание?",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "skinFeaturesDetails",
          "label": "Перечислите их",
          "type": "textarea",
          "required": true,
          "maxLength": 500,
          "rows": 2,
          "showIf": {
            "field": "skinFeatures",
            "equals": "Да"
          }
        },
        {
          "name": "boneInjuries",
          "label": "Есть в настоящее время нарушения целостности костей (переломы, вывихи)?",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "boneInjuriesDetails",
          "label": "Опишите, что именно",
          "type": "textarea",
          "required": true,
          "maxLength": 500,
          "rows": 2,
          "showIf": {
            "field": "boneInjuries",
            "equals": "Да"
          }
        },
        {
          "name": "spineConditions",
          "label": "Есть в настоящее время заболевания, связанные с позвоночником или наличием межпозвонковых грыж?",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "spineConditionsDetails",
          "label": "Укажите их",
          "type": "textarea",
          "required": true,
          "maxLength": 500,
          "rows": 2,
          "showIf": {
            "field": "spineConditions",
            "equals": "Да"
          }
        },
        {
          "name": "surgeries",
          "label": "Были хирургические вмешательства за последние 3 года?",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "surgeriesDetails",
          "label": "Перечислите их",
          "type": "textarea",
          "required": true,
          "maxLength": 500,
          "rows": 2,
          "showIf": {
            "field": "surgeries",
            "equals": "Да"
          }
        },
        {
          "name": "pregnancy",
          "label": "Наличие беременности или кормления грудью",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        },
        {
          "name": "intoxication",
          "label": "Пребывание в данный момент в алкогольном и/или наркотическом опьянении",
          "type": "radio",
          "required": true,
          "options": [
            "Да",
            "Нет"
          ]
        }
      ]
    },
    {
      "title": "Знакомство",
      "fields": [
        {
          "name": "source",
          "label": "Откуда узнали о нас?",
          "type": "multiselect",
          "required": false,
          "hint": "Можно выбрать несколько вариантов",
          "options": [
            "Instagram",
            "Telegram",
            "2ГИС",
            "Yandex",
            "Google",
            "От блогера",
            "С мероприятия",
            "Наружная реклама",
            "Рекомендация",
            "Подарили сертификат"
          ]
        },
        {
          "name": "firstTime",
          "label": "На массаже первый раз в жизни?",
          "type": "radio",
          "required": false,
          "options": [
            "Да",
            "Нет"
          ]
        }
      ]
    },
    {
      "title": "Пожелания к сеансу",
      "fields": [
        {
          "name": "massageType",
          "label": "Какой массаж выберете?",
          "type": "radio",
          "required": true,
          "options": [
            "Релакс",
            "Классика",
            "Спорт"
          ],
          "hint": "Релакс — для тех, кто очень устал и нуждается в полной перезагрузке, используются приёмы поглаживания. Классика — комплексное оздоровление и повышение работоспособности, приёмы поглаживания и разминания. Спорт — восстановление мышц после тяжёлых тренировок, приёмы интенсивного разминания мышц."
        },
        {
          "name": "headMassage",
          "label": "Голову массировать?",
          "type": "radio",
          "required": false,
          "options": [
            "Да",
            "Нет"
          ],
          "hint": "Работаем без масла"
        },
        {
          "name": "music",
          "label": "Под какую музыку вы чувствуете себя максимально комфортно?",
          "type": "multiselect",
          "required": false,
          "hint": "Можно выбрать несколько вариантов",
          "options": [
            "Классическая музыка",
            "Jazz",
            "Chillout",
            "Hip-Hop",
            "Техно"
          ]
        },
        {
          "name": "musicOwn",
          "label": "Свой вариант музыки",
          "type": "text",
          "required": false,
          "wide": true,
          "maxLength": 120,
          "placeholder": "Напишите, что включить"
        },
        {
          "name": "communication",
          "label": "Что предпочитаете?",
          "type": "radio",
          "required": false,
          "options": [
            "Диалог",
            "Тишина",
            "Не принципиально"
          ]
        },
        {
          "name": "oil",
          "label": "У нас есть разное масло. Какое выберете?",
          "type": "radio",
          "required": false,
          "options": [
            "Базовое — виноградная косточка (без запаха)",
            "Цитрус",
            "Зелёный чай",
            "Сандал"
          ]
        },
        {
          "name": "underwear",
          "label": "Понадобится вам одноразовое нижнее бельё?",
          "type": "radio",
          "required": false,
          "options": [
            "Да, нужно",
            "Нет, останусь в своём"
          ]
        }
      ]
    },
    {
      "title": "После массажа",
      "fields": [
        {
          "name": "drink",
          "label": "После массажа хочу",
          "type": "radio",
          "required": false,
          "options": [
            "Чай зелёный",
            "Чай травяной",
            "Чай чёрный",
            "Чай с чабрецом",
            "Чай с бергамотом",
            "Чай фруктовый",
            "Какао",
            "Ничего"
          ]
        },
        {
          "name": "drinkAdditions",
          "label": "Добавить в чай",
          "type": "multiselect",
          "required": false,
          "hint": "Можно выбрать оба варианта",
          "options": [
            "Лимон",
            "Сахар"
          ],
          "showIf": {
            "field": "drink",
            "notIn": [
              "Какао",
              "Ничего"
            ]
          }
        }
      ]
    }
  ],
  "signature": {
    "label": "Подпись гостя",
    "required": true,
    "statement": "Своей подписью подтверждаю достоверность указанных сведений и согласие с условиями, перечисленными выше."
  }
}
